rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Profilul de utilizator & Informațiile de Abonament (Strict Securizat)
    match /users/{userId} {
      // Utilizatorul autentificat își poate citi exclusiv propriul status PRO
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Doar backend-ul de încredere (Firebase Admin SDK via Webhook Stripe sau Cloud Functions)
      // are dreptul să modifice statutul PRO sau creditele de export.
      allow write: if false;

      // Draft-uri & Versiuni CV salvate în Cloud (Opțional / Sync Cloud)
      match /drafts/{draftId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Blocare implicită pentru orice altă colecție nedeclarată
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
