rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Profilul de utilizator & Informațiile de Abonament (Strict Securizat)
    match /users/{userId} {
      // Utilizatorul autentificat își poate citi exclusiv propriul status PRO
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Doar backend-ul de încredere (Firebase Admin SDK via Webhook Stripe sau Cloud Functions)
      // are dreptul să modifice statutul PRO sau creditele de export.
      allow write: if false;

      // Draft-uri & Versiuni CV salvate în Cloud (Strict Ownership + Schema Validation)
      match /drafts/{draftId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null
                     && request.auth.uid == userId
                     && request.resource.data.keys().hasOnly(['updatedAt', 'cvData', 'name']);
      }
    }

    // Registru Imutabil Credite (Append-only via Admin SDK, Read-only pt proprietar)
    match /credit_ledger/{entryId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      allow write: if false;
    }

    // Blocare implicită pentru orice altă colecție nedeclarată
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
